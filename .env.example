# Copy this to .env and fill in your Firebase project values
# Get these from: Firebase Console → Project Settings → Your apps → Web app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# For the seed scripts only (never commit this to git)
# Generate from: Firebase Console → Project Settings → Service Accounts → Generate new key
# Then paste the entire JSON as a single line:
FIREBASE_SERVICE_ACCOUNT=

# ── Cloudflare Pages Functions (Summary Service) ──────────────────────────────
# Set these in Cloudflare Pages → Settings → Environment variables:
ANTHROPIC_API_KEY=
FIREBASE_PROJECT_ID=
# Optional (defaults to claude-haiku-4-5-20251001):
# CLAUDE_MODEL=claude-haiku-4-5-20251001
